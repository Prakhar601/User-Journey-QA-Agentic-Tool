# ============================================================
# Autonomous User-Journey QA Agent — Environment Configuration
# AMD AI DevMaster Hackathon Submission
# ============================================================
# Copy this file to .env and fill in the values for your
# chosen LLM provider. Only one provider needs to be configured
# to run the agent. All three can be configured simultaneously
# for benchmarking.
# ============================================================

# ── Provider Selection ────────────────────────────────────────
# Options: amd | github | ollama
# Recommendation: Set to "amd" for the hackathon demo.
MODEL_PROVIDER=amd

# Optional: Override the model for all providers
# MODEL_NAME=

# ── AMD / Fireworks AI (MODEL_PROVIDER=amd) ─────────────────
AMD_BASE_URL=https://api.fireworks.ai/inference/v1
AMD_API_KEY=
AMD_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
AMD_TIMEOUT=120000

# ── GitHub Models (MODEL_PROVIDER=github) ───────────────────
GITHUB_PAT=
GITHUB_MODEL=openai/gpt-4.1-mini

# ── Ollama / Local (MODEL_PROVIDER=ollama) ──────────────────
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=llama3
LLM_PROVIDER=ollama

# ── Shared Timeout ───────────────────────────────────────────
LLM_TIMEOUT=120000
MODEL_TIMEOUT=120000

# ── Auto-Launch Mode (npm run launch) ───────────────────────
# These are only required when running in non-interactive mode.
URL=
USERNAME=
PASSWORD=
WORKFLOW_DESCRIPTIONS=Login and verify dashboard,Check profile page
MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
AUTOMATION_TOOL=playwright
TIMEOUT_SECONDS=60

# ── Benchmark (npm run benchmark) ───────────────────────────
# Comma-separated list of providers to benchmark.
# Leave blank to auto-detect all configured providers.
# BENCHMARK_PROVIDERS=amd,github,ollama
BENCHMARK_RETRIES=1

# ── Launch Mode (npm run launch) ───────────────────────────
# DRY_RUN_TARGET_URL=https://your-staging-app.com
# DRY_RUN_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ── Python Agent (optional supplemental agent) ──────────────
# Full path to the Python executable if not on PATH.
# PYTHON_PATH=python
