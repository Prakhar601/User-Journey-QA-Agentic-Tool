# LLM Provider Selection
MODEL_PROVIDER=ollama
MODEL_NAME=llama3

# --- GitHub Models (MODEL_PROVIDER=github) ---
GITHUB_PAT=
GITHUB_MODEL=openai/gpt-4.1-mini

# --- Ollama / Local (MODEL_PROVIDER=ollama or local) ---
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=llama3
LLM_PROVIDER=ollama

# --- AMD Radeon Cloud (MODEL_PROVIDER=amd) ---
AMD_BASE_URL=
AMD_API_KEY=
AMD_MODEL=
AMD_TIMEOUT=120000

# --- Shared ---
LLM_TIMEOUT=120000
MODEL_TIMEOUT=120000

# --- Benchmark (optional) ---
# BENCHMARK=true
# BENCHMARK_PROVIDERS=github,ollama,amd
# BENCHMARK_RETRIES=1
